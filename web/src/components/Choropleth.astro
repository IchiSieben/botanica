---
/**
 * Coropleta de los 25 departamentos. Fuente: mart_richness_by_department.
 * Toggle: especies (default) / registros / especies por mil registros (proxy
 * crudo de cobertura). El caveat de esfuerzo de muestreo es PROTAGONISTA, no
 * un tooltip secundario. 'unassigned' (0.1%) va como nota de calidad, NO se
 * pinta como departamento.
 */
import { getRichness } from '../lib/data';
import { n } from '../lib/format';

interface Props { kingdom?: string; }
const { kingdom = 'Plantae' } = Astro.props;

const rows = getRichness(kingdom);
const depts = rows.filter((r) => r.department !== 'unassigned' && r.department !== '(sin depto)');
const unassigned = rows.find((r) => r.department === 'unassigned');

// Tres métricas por departamento. coverage = especies por mil registros.
const data = depts.map((d) => ({
  name: d.department,
  records: d.records,
  species: d.species,
  coverage: d.records > 0 ? +(d.species / d.records * 1000).toFixed(1) : 0,
}));

// Contraste protagonista: sobre-colectado (más registros) vs más rico.
const byRecords = [...data].sort((a, b) => b.records - a.records)[0];
const bySpecies = [...data].sort((a, b) => b.species - a.species)[0];
const showContrast = data.length > 1 && byRecords.name !== bySpecies.name;

const chartData = { data };
---

<div class="card">
  <div class="card-head">
    <h3>Riqueza y esfuerzo por departamento</h3>
    <span class="src">mart_richness_by_department</span>
  </div>

  <div class="caveat">
    <b>La riqueza por departamento refleja también el esfuerzo de colecta, no solo biodiversidad.</b>
    {showContrast ? (
      <>
        Ej.: <b>{byRecords.name}</b> tiene {n(byRecords.records)} registros ({(byRecords.records / bySpecies.records).toFixed(1)}× los de {bySpecies.name})
        pero <b>menos especies</b> ({n(byRecords.species)}) que <b>{bySpecies.name}</b> ({n(bySpecies.species)}).
      </>
    ) : (
      <>Los departamentos con más colecta acumulan más registros; eso sesga cualquier lectura de “riqueza”.</>
    )}
    Por eso el default es <b>especies</b>, y “especies por mil registros” es un proxy crudo de cobertura.
  </div>

  <div class="seg" id="metric-toggle" role="tablist" style="margin-top:10px">
    <button data-metric="species" class="on">especies</button>
    <button data-metric="records">registros</button>
    <button data-metric="coverage">especies / mil registros</button>
  </div>

  <div id="chart-map" class="chart tall" style="margin-top:8px"></div>

  <p class="note-quality">
    {unassigned && (
      <>Calidad de datos: <b>{n(unassigned.records)}</b> registros (0.1%, {n(unassigned.species)} especies)
      quedaron <b>sin ubicar</b> — costa/islas o coordenadas erróneas fuera de todo polígono. No se pintan en el mapa.</>
    )}
  </p>
  <script type="application/json" id="data-map" set:html={JSON.stringify(chartData)} />
</div>

<script>
  import { echarts, makeChart, readJSON, tooltipStyle, T, registerGeoMap } from '../lib/echarts-client';
  import { MapChart } from 'echarts/charts';
  echarts.use([MapChart]);

  interface Row { name: string; records: number; species: number; coverage: number; }
  const { data } = readJSON<{ data: Row[] }>('data-map');

  const METRICS: Record<string, { label: string; key: 'records' | 'species' | 'coverage' }> = {
    species: { label: 'especies', key: 'species' },
    records: { label: 'registros', key: 'records' },
    coverage: { label: 'especies / mil registros', key: 'coverage' },
  };

  const fmt = (v: number) => v.toLocaleString('es-PE');

  async function init() {
    // El sitio se sirve desde /botanica/, no desde la raiz: una ruta absoluta
    // pide el geojson al dominio y da 404. BASE_URL lo resuelve en build.
    await registerGeoMap('peru', `${import.meta.env.BASE_URL}data/peru_departamentos.geojson`);

    const chart = makeChart('chart-map', baseOption('species'));
    if (!chart) return;

    document.querySelectorAll<HTMLButtonElement>('#metric-toggle button').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#metric-toggle button').forEach((b) => b.classList.remove('on'));
        btn.classList.add('on');
        const metric = btn.dataset.metric!;
        const m = METRICS[metric];
        const max = Math.max(...data.map((d) => d[m.key]));
        chart.setOption({
          visualMap: { max, text: [fmt(max), '0'] },
          series: [{ name: m.label, data: data.map((d) => ({ name: d.name, value: d[m.key] })) }],
        });
      });
    });
  }

  function baseOption(metric: string): any {
    const m = METRICS[metric];
    const max = Math.max(...data.map((d) => d[m.key]));
    return {
      tooltip: {
        ...tooltipStyle, trigger: 'item',
        formatter: (p: any) => {
          const d = data.find((x) => x.name === p.name);
          if (!d) return `${p.name}<br/><span style="color:${T.dim}">sin datos</span>`;
          return `<b style="font-family:${T.display};font-size:14px;color:#f0e9da">${p.name}</b><br/>` +
            `${fmt(d.species)} especies<br/>${fmt(d.records)} registros<br/>` +
            `<span style="color:${T.dim}">${d.coverage} especies / mil registros</span>`;
        },
      },
      visualMap: {
        type: 'continuous', min: 0, max, left: 8, bottom: 8, calculable: true,
        text: [fmt(max), '0'],
        textStyle: { color: T.dim, fontFamily: T.font, fontSize: 10 },
        inRange: { color: ['#16231d', '#2f5d3a', '#59ad63', '#9bbf6a', '#dbe8a6'] },
        outOfRange: { color: '#16231d' },
      },
      series: [{
        type: 'map', map: 'peru', nameProperty: 'NOMBDEP', name: m.label,
        roam: false, aspectScale: 0.85,
        left: 0, right: 0, top: 10, bottom: 10,
        itemStyle: { borderColor: T.ink, borderWidth: 0.6 },
        emphasis: {
          itemStyle: { areaColor: T.gold },
          label: { show: false },
        },
        select: { disabled: true },
        label: { show: false },
        data: data.map((d) => ({ name: d.name, value: d[m.key] })),
      }],
    };
  }

  init();
</script>
