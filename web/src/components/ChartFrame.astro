---
/**
 * Contract for every chart (brief v3 item 3): a title, one "How to read this" line,
 * the chart, a legend with units, and a source line with dataset + DOI/version.
 * Slots: default = the chart; `legend` = legend markup (units included); `tools` = buttons
 * next to the title (zoom, fullscreen...). Client code may update `[data-cf-howto]`.
 */
import { t, type Locale } from '../lib/i18n';
import { SOURCES, sourceHref, type Source, type SourceKey } from '../lib/sources';
import '../styles/frame.css';

interface Props {
  locale: Locale;
  id?: string;
  title: string;
  howto: string;
  sources: SourceKey[];
  /** Heading level of the title; default 2. */
  level?: 2 | 3;
  class?: string;
}
const { locale, id, title, howto, sources, level = 2, class: cls } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const list: Source[] = sources.map((k) => SOURCES[k]);
---
<figure class:list={['cf', cls]} id={id} data-chart={id}>
  <div class="cf-head">
    <H class="cf-title">{title}</H>
    {Astro.slots.has('tools') && <div class="cf-tools"><slot name="tools" /></div>}
  </div>
  <p class="cf-howto"><button type="button" class="cf-k cf-howto-k" aria-expanded="true">{t(locale, 'frame.howto')}</button> <span data-cf-howto>{howto}</span></p>
  <div class="cf-body"><slot /></div>
  <figcaption class="cf-foot">
    {Astro.slots.has('legend') && <div class="cf-legend" role="group" aria-label={t(locale, 'frame.legend')}><slot name="legend" /></div>}
    <p class="cf-source">
      <span class="cf-k">{t(locale, list.length > 1 ? 'frame.sources' : 'frame.source')}:</span>
      {list.map((s, i) => (
        <>{i > 0 && ' · '}<a href={sourceHref(s)} rel="noopener" target="_blank" lang="en">{s.label}</a>{s.version && <span class="cf-ver"> ({s.version})</span>}{s.doi && <span class="cf-doi"> doi:{s.doi}</span>}</>
      ))}
    </p>
  </figcaption>
</figure>

<script>
  // v3.2 B3: "How to read this" is whole on the first visit, then one line with an expand
  // control (the label). Base.astro's head script sets .howto-seen before the first paint.
  const seen = document.documentElement.classList.contains('howto-seen');
  document.querySelectorAll<HTMLButtonElement>('.cf-howto-k').forEach((b) => {
    const p = b.parentElement!;
    p.toggleAttribute('data-open', !seen);
    p.setAttribute('data-js', '');
    b.setAttribute('aria-expanded', String(!seen));
    b.addEventListener('click', () => {
      const open = !p.hasAttribute('data-open');
      p.toggleAttribute('data-open', open);
      b.setAttribute('aria-expanded', String(open));
    });
  });
  try { localStorage.setItem('botanica.howto.seen', '1'); } catch {}
</script>
