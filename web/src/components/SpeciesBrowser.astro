---
/**
 * Species finder: one page for all 23,387 species.
 *
 * Why not 23,387 static pages: generating them would take minutes, weigh
 * hundreds of MB, and nobody browses an atlas that way. The columnar index
 * (species-*.json, built by etl/build_species_index.py) downloads once and the
 * search runs in the browser, with no backend and no per-query cost.
 *
 * v3.1: virtual scrolling replaced the 200-row cap (the list can now reach the
 * last of 21,585 rows), a list/grid toggle, sort (name/year/records/family) and
 * filters (endemic, department, family) that share the explorer's URL fields
 * (?dep=, ?fam=, ?st=endemica) so a link round-trips between the two pages. The
 * detail pane now renders through the same drawer.ts template as the explorer's
 * drawer (mini map, timeline, same-genus, IPNI/GBIF/POWO).
 */
import { t, type Locale } from '../lib/i18n';
import { departmentPaths } from '../lib/geo';
import { getCladeByDept } from '../lib/data';
import { speciesRowHtml, FIRST_SCREEN, ROW_H } from '../lib/species-row';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

interface Props { locale: Locale }
const { locale } = Astro.props;

// Build-time only: the same department polygons the explorer's #map uses, so the
// drawer's mini map on this page (which has no #map to clone paths from) matches.
const { paths: deptPaths, width: mapW, height: mapH } = departmentPaths();
const mapAsset = { paths: deptPaths.map((p) => ({ name: p.name, d: p.d })), width: mapW, height: mapH };

// v3.2 B1: the first screen of the default view (Plants, by name) is in the HTML, so the first
// row paints with the document instead of after the 1.2 MB index (docs/PERF-v3.2.md). The
// client keeps these rows only while the URL asks for exactly that view.
const readData = (f: string) => JSON.parse(readFileSync(fileURLToPath(new URL(`../../public/data/${f}`, import.meta.url)), 'utf8'));
// v3.2 B2: each row carries its order's colour, the same palette as the tree (PhyloTree.astro).
const orderColors: Record<'plantae' | 'fungi', Record<string, string>> = { plantae: {}, fungi: {} };
for (const [k, K] of [['plantae', 'Plantae'], ['fungi', 'Fungi']] as const) {
  for (const r of getCladeByDept(K)) orderColors[k][r.clade] ??= r.color;
}
const plantIdx = readData('species-plantae.json') as { meta: { flags: { endemic: number } }; families: string[]; orders: string[]; rows: [string, number, number, number, unknown, number][] };
const plantF = readData('facets-plantae.json') as { year: number[] | null; mask: number[]; depts: string[] };
const popcount = (m: number) => { let c = 0; for (; m; m &= m - 1) c++; return c; };
const total = plantIdx.rows.length;
const firstRows = plantIdx.rows.slice(0, FIRST_SCREEN).map((r, i) => {
  const order = r[2] >= 0 ? plantIdx.orders[r[2]] : null;
  return speciesRowHtml(locale, {
    i, name: r[0], family: r[1] >= 0 ? plantIdx.families[r[1]] : null, order, records: r[3], year: plantF.year?.[i] || null,
    color: order ? orderColors.plantae[order] ?? null : null, endemic: !!(r[5] & plantIdx.meta.flags.endemic),
    depts: popcount(plantF.mask[i] ?? 0), deptTotal: plantF.depts.length,
    selected: false, posinset: i + 1, setsize: total,
  }, false);
}).join('');
---

<div class="sp" data-species-root>
  <header class="sp-head">
    <div class="sp-search">
      <label class="sr-only" for="sp-q">{t(locale, 'search.label')}</label>
      <input type="search" id="sp-q" placeholder={t(locale, 'search.placeholder')} autocomplete="off" spellcheck="false" />
      <span class="sp-count mono" id="sp-count" aria-live="polite">{t(locale, 'search.loading')}</span>
    </div>
    <div class="sp-kingdoms seg" role="group" aria-label={t(locale, 'k.label')}>
      <button type="button" class="btn on" data-kingdom="plantae" aria-pressed="true">{t(locale, 'k.plantae')}</button>
      <button type="button" class="btn" data-kingdom="fungi" aria-pressed="false">{t(locale, 'k.fungi')}</button>
    </div>
  </header>

  <div class="sp-tools">
    <div class="sp-tool">
      <label class="sr-only" for="sp-sort">{t(locale, 'species.sort.label')}</label>
      <select id="sp-sort" class="btn">
        <option value="name">{t(locale, 'species.sort.label')}: {t(locale, 'species.sort.name')}</option>
        <option value="year">{t(locale, 'species.sort.label')}: {t(locale, 'species.sort.year')}</option>
        <option value="records">{t(locale, 'species.sort.label')}: {t(locale, 'species.sort.records')}</option>
        <option value="family">{t(locale, 'species.sort.label')}: {t(locale, 'species.sort.family')}</option>
      </select>
    </div>
    <div class="sp-tool">
      <label class="sr-only" for="sp-fam">{t(locale, 'species.filters.family')}</label>
      <select id="sp-fam" class="btn"><option value="">{t(locale, 'species.filters.anyFamily')}</option></select>
    </div>
    <div class="sp-tool">
      <label class="sr-only" for="sp-dep">{t(locale, 'species.filters.dept')}</label>
      <select id="sp-dep" class="btn"><option value="">{t(locale, 'species.filters.anyDept')}</option></select>
    </div>
    <label class="sp-tool sp-check">
      <input type="checkbox" id="sp-endemic" /> {t(locale, 'species.filters.endemic')}
    </label>
    <button type="button" class="btn" id="sp-clear">{t(locale, 'species.filters.clear')}</button>
    <div class="sp-view seg" role="group" aria-label={t(locale, 'species.view.label')}>
      <button type="button" class="btn on" data-view="list" aria-pressed="true">{t(locale, 'species.view.list')}</button>
      <button type="button" class="btn" data-view="grid" aria-pressed="false">{t(locale, 'species.view.grid')}</button>
    </div>
  </div>

  <div class="sp-body">
    <div class="sp-list-wrap" id="sp-list-wrap">
      <div class="sp-list" id="sp-list" role="listbox" aria-label={t(locale, 'species.results')} tabindex="0">
        <div class="sp-spacer" id="sp-spacer" style={`height:${total * ROW_H}px`}>
          <div class="sp-viewport list" id="sp-viewport" data-ssr set:html={firstRows}></div>
        </div>
      </div>
    </div>
    <aside class="sp-detail" id="sp-detail-wrap" aria-labelledby="dr-title">
      <button type="button" class="btn sp-close" id="sp-close" aria-label={t(locale, 'species.detail.close')}>✕</button>
      <div id="sp-detail" aria-live="polite"><p class="note">{t(locale, 'species.pick')}</p></div>
    </aside>
  </div>

  <script type="application/json" id="sp-map" set:html={JSON.stringify(mapAsset)} />
  <script type="application/json" id="sp-colors" set:html={JSON.stringify(orderColors)} />
</div>

<script>
  import { createStore, serialize, EMPTY, type SpSort, type SpView } from '../lib/store';
  import { t, fmt, localePath, type Locale } from '../lib/i18n';
  import { deptName } from '../lib/depts';
  import { afterPaint } from '../lib/after-paint';
  import { dataUrl } from '../lib/data-url';
  import { renderDrawer, yearHistogram, type DrawerMap, type DrawerSpecies, type DrawerYearDist } from '../lib/drawer';
  import { speciesRowHtml, ROW_H, CARD_H } from '../lib/species-row';

  type Row = [string, number, number, number, [number, number][], number, number];
  interface Index {
    meta: { flags: Record<'native' | 'introduced' | 'endemic', number> };
    families: string[]; orders: string[]; depts: string[]; lifeforms: string[]; rows: Row[];
  }
  interface Facets {
    meta: { flags: Record<'native' | 'introduced' | 'endemic', number> };
    depts: string[]; families: string[]; orders: string[]; lifeforms: string[];
    fam: number[]; ord: number[]; life: number[]; flags: number[]; mask: number[]; year: number[] | null;
  }
  interface Proto { rows: [ipniId: string, authors: string, acceptedIpniId: string][] }
  type K = 'plantae' | 'fungi';

  const root = document.querySelector<HTMLElement>('[data-species-root]');
  if (root) {
    const locale = (document.documentElement.lang as Locale) || 'en';
    const n = fmt(locale);
    const store = createStore();
    const $q = document.getElementById('sp-q') as HTMLInputElement;
    const $sort = document.getElementById('sp-sort') as HTMLSelectElement;
    const $fam = document.getElementById('sp-fam') as HTMLSelectElement;
    const $dep = document.getElementById('sp-dep') as HTMLSelectElement;
    const $endemic = document.getElementById('sp-endemic') as HTMLInputElement;
    const $clear = document.getElementById('sp-clear') as HTMLButtonElement;
    const $list = document.getElementById('sp-list') as HTMLDivElement;
    const $spacer = document.getElementById('sp-spacer') as HTMLDivElement;
    const $viewport = document.getElementById('sp-viewport') as HTMLDivElement;
    const $detail = document.getElementById('sp-detail')!;
    const $count = document.getElementById('sp-count')!;
    const mapAsset = JSON.parse(document.getElementById('sp-map')!.textContent!) as DrawerMap;
    const orderColors = JSON.parse(document.getElementById('sp-colors')!.textContent!) as Record<K, Record<string, string>>;
    const popcount = (m: number) => { let c = 0; for (; m; m &= m - 1) c++; return c; };
    const esc = (s: string) => s.replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c] as string);

    const cache = new Map<K, Promise<{ idx: Index; f: Facets }>>();
    const load = (k: K) => {
      if (!cache.has(k)) {
        cache.set(k, Promise.all([
          fetch(dataUrl(`species-${k}`), { priority: 'low' }).then((r) => { if (!r.ok) throw new Error(`${r.status} species-${k}`); return r.json() as Promise<Index>; }),
          fetch(dataUrl(`facets-${k}`), { priority: 'low' }).then((r) => { if (!r.ok) throw new Error(`${r.status} facets-${k}`); return r.json() as Promise<Facets>; }),
        ]).then(([idx, f]) => ({ idx, f })));
      }
      return cache.get(k)!;
    };
    // Protologue (IPNI/POWO ids): plants only, lazy, on the first drawer open.
    let proto: Proto | null = null;
    let protoReq: Promise<void> | null = null;
    const loadProto = () => {
      protoReq ??= fetch(dataUrl('protologue-plantae'), { priority: 'low' })
        .then((r) => { if (!r.ok) throw new Error(`${r.status} protologue`); return r.json() as Promise<Proto>; })
        .then((d) => { proto = d; renderDetail(store.get().sp); })
        .catch((e) => { protoReq = null; console.warn(e); });
      return protoReq;
    };

    let idx: Index | null = null;
    let f: Facets | null = null;
    let matched: number[] = [];
    const yearDist = new Map<K, DrawerYearDist | null>();

    // ---- sort permutations: built on first use, per kingdom, and kept ----
    // v3.2 B1: they were three eager localeCompare sorts of 21,585 rows on every kingdom load
    // (~1.8 s at 4x CPU) although only one is ever on screen. Ties break by row index: the
    // index is already ORDER BY name, so that is the name order without comparing strings.
    const orders = new Map<K, Partial<Record<SpSort, number[]>>>();
    const collator = new Intl.Collator('en');
    function orderOf(sort: SpSort): number[] {
      const k = loadedFor!;
      const memo = orders.get(k) ?? orders.set(k, {}).get(k)!;
      if (memo[sort]) return memo[sort]!;
      const rows = idx!.rows;
      const all = rows.map((_, i) => i);
      let o = all;
      if (sort === 'records') o = all.sort((a, b) => rows[b][3] - rows[a][3] || a - b);
      else if (sort === 'year') {
        const y = f!.year;
        o = all.sort((a, b) => {
          const ya = y?.[a] || 0, yb = y?.[b] || 0;
          if (!ya || !yb) return (ya ? -1 : yb ? 1 : 0) || a - b;
          return ya - yb || a - b;
        });
      } else if (sort === 'family') {
        // Rank families once (257 names), then sort rows by an integer.
        const rank = idx!.families.map((_, i) => i).sort((a, b) => collator.compare(idx!.families[a], idx!.families[b]));
        const pos = new Int32Array(idx!.families.length);
        rank.forEach((fi, r) => { pos[fi] = r; });
        const key = (i: number) => (rows[i][1] >= 0 ? pos[rows[i][1]] : 1e9);
        o = all.sort((a, b) => key(a) - key(b) || a - b);
      }
      return (memo[sort] = o);
    }

    function populateFilters() {
      const famNames = [...idx!.families].sort((a, b) => a.localeCompare(b));
      $fam.innerHTML = `<option value="">${t(locale, 'species.filters.anyFamily')}</option>` +
        famNames.map((x) => `<option value="${esc(x)}">${esc(x)}</option>`).join('');
      const depNames = f!.depts.map((d) => [d, deptName(d)] as const).sort((a, b) => a[1].localeCompare(b[1]));
      $dep.innerHTML = `<option value="">${t(locale, 'species.filters.anyDept')}</option>` +
        depNames.map(([code, name]) => `<option value="${esc(code)}">${esc(name)}</option>`).join('');
    }

    function match(): number[] {
      if (!idx || !f) return [];
      const s = store.get();
      const q = $q.value.trim().toLowerCase();
      const famFilter = s.fam;
      const depIdx = s.dep[0] ? f.depts.indexOf(s.dep[0]) : -1;
      const endemicOnly = s.st === 'endemica';
      const F = idx.meta.flags;
      const base = orderOf(s.sort);
      const out: number[] = [];
      for (const i of base) {
        const r = idx.rows[i];
        if (q) {
          const fam = r[1] >= 0 ? idx.families[r[1]] : '';
          if (!r[0].toLowerCase().includes(q) && !fam.toLowerCase().includes(q)) continue;
        }
        if (famFilter && (r[1] < 0 || idx.families[r[1]] !== famFilter)) continue;
        if (depIdx >= 0 && !((f.mask[i] >> depIdx) & 1)) continue;
        if (endemicOnly && !(r[5] & F.endemic)) continue;
        out.push(i);
      }
      return out;
    }

    // ---- virtual list: fixed row height, windowed rendering ----------------------
    const CARD_MIN = 200;
    const OVERSCAN = 6;
    function cols(): number {
      if (store.get().view !== 'grid') return 1;
      return Math.max(1, Math.floor($list.clientWidth / CARD_MIN));
    }
    function rowH(): number {
      return store.get().view === 'grid' ? CARD_H : ROW_H;
    }

    function rowHtml(i: number, posinset: number): string {
      const r = idx!.rows[i];
      const order = r[2] >= 0 ? idx!.orders[r[2]] : null;
      return speciesRowHtml(locale, {
        i, name: r[0], family: r[1] >= 0 ? idx!.families[r[1]] : null, order, records: r[3], year: f!.year?.[i] || null,
        color: order ? orderColors[loadedFor!]?.[order] ?? null : null, endemic: !!(r[5] & idx!.meta.flags.endemic),
        depts: f!.mask[i] != null ? popcount(f!.mask[i]) : null, deptTotal: f!.depts.length,
        selected: r[0] === store.get().sp, posinset, setsize: matched.length,
      }, store.get().view === 'grid');
    }

    /** Keyboard cursor: an index into `matched`. -1 = none; reset whenever `matched` changes. */
    let active = -1;

    function renderWindow() {
      if (!idx) return;
      const total = matched.length;
      const c = cols();
      const rh = rowH();
      const rows = Math.ceil(total / c);
      $spacer.style.height = `${rows * rh}px`;
      // Row and set size are on each option (aria-posinset/setsize): aria-rowcount is not allowed on a listbox.
      const scrollTop = $list.scrollTop;
      const firstRow = Math.max(0, Math.floor(scrollTop / rh) - OVERSCAN);
      const visibleRows = Math.ceil($list.clientHeight / rh) + OVERSCAN * 2;
      const lastRow = Math.min(rows, firstRow + visibleRows);
      $viewport.style.transform = `translateY(${firstRow * rh}px)`;
      const grid = store.get().view === 'grid';
      $viewport.className = `sp-viewport ${grid ? 'grid' : 'list'}`;
      if (grid) $viewport.style.setProperty('--sp-cols', String(c));
      let html = '';
      for (let row = firstRow; row < lastRow; row++) {
        for (let ci = 0; ci < c; ci++) {
          const pos = row * c + ci;
          if (pos >= total) break;
          html += rowHtml(matched[pos], pos + 1);
        }
      }
      $viewport.innerHTML = html;
      delete $viewport.dataset.ssr;
    }

    function renderList() {
      matched = match();
      active = -1;
      const extra = ` · ${t(locale, 'species.of')} ${n(idx!.rows.length)}`;
      $count.textContent = `${n(matched.length)}${extra}`;
      renderWindow();
    }

    function renderDetail(name: string | null) {
      const i = name && idx ? idx.rows.findIndex((r) => r[0] === name) : -1;
      root!.toggleAttribute('data-open', i >= 0);
      if (!idx || !f || i < 0) {
        $detail.innerHTML = `<p class="note">${t(locale, 'species.pick')}</p>`;
        return;
      }
      const s = store.get();
      const r = idx.rows[i];
      const fam = r[1] >= 0 ? idx.families[r[1]] : null;
      const ord = r[2] >= 0 ? idx.orders[r[2]] : null;
      const group = f.life[i] >= 0 ? f.lifeforms[f.life[i]] : null;
      const raw = r[6] >= 0 ? idx.lifeforms[r[6]] : null;
      const year = f.year?.[i] || null;
      const plant = s.k === 'plantae';
      if (plant && !proto) void loadProto();
      const genus = r[0].split(' ')[0];
      const sameGenus = idx.rows
        .filter((row) => row[0] !== r[0] && row[0].split(' ')[0] === genus)
        .map((row) => row[0])
        .slice(0, 12);
      if (!yearDist.has(s.k)) yearDist.set(s.k, yearHistogram(f.year));
      const sp: DrawerSpecies = {
        name: r[0], kingdom: s.k, family: fam, order: ord,
        flags: r[5], flagBits: idx.meta.flags, records: r[3],
        topDepts: r[4].map(([d, c]) => [deptName(idx!.depts[d]), c]),
        lifeformGroup: group, lifeformRaw: raw, year,
        proto: plant && proto ? { authors: proto.rows[i]?.[1] ?? '', ipniId: proto.rows[i]?.[0] ?? '', acceptedIpniId: proto.rows[i]?.[2] ?? '' } : null,
        deptMask: f.mask[i] ?? null,
        sameGenus,
      };
      const mapHref = `${localePath(locale)}${serialize({ ...EMPTY, k: s.k, sp: r[0] })}`;
      const links = {
        mapHref,
        famHref: fam ? `${localePath(locale, 'especies/')}${serialize({ ...EMPTY, k: s.k, fam })}` : null,
        speciesHref: (nm: string) => `${localePath(locale, 'especies/')}${serialize({ ...store.get(), sp: nm })}`,
      };
      // The mini map's paths are shared across kingdoms; facetDepts (mask bit order) is not.
      const mapCtx: DrawerMap = { ...mapAsset, facetDepts: f.depts };
      $detail.innerHTML = renderDrawer(locale, sp, mapCtx, plant ? yearDist.get(s.k) ?? null : null, links);
    }

    let loadedFor: K | null = null;
    async function render() {
      const s = store.get();
      document.documentElement.dataset.sk = s.k; // the page lede follows the kingdom (pages/Species.astro)
      root!.querySelectorAll<HTMLButtonElement>('[data-kingdom]').forEach((b) => {
        const on = b.dataset.kingdom === s.k;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      root!.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => {
        const on = b.dataset.view === s.view;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      if (loadedFor !== s.k) {
        $count.textContent = t(locale, 'search.loading');
        try {
          ({ idx, f } = await load(s.k));
        } catch (e) {
          $count.textContent = t(locale, 'species.error');
          console.warn(e);
          return;
        }
        if (store.get() !== s) return;
        loadedFor = s.k;
        populateFilters();
        prefetchOther(s.k);
      }
      // After populateFilters(): a family or department option only exists once its kingdom loaded.
      $sort.value = s.sort;
      $fam.value = s.fam ?? '';
      $dep.value = s.dep[0] ?? '';
      $endemic.checked = s.st === 'endemica';
      renderList();
      renderDetail(s.sp);
    }

    let timer: number | undefined;
    $q.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(renderList, 120);
    });
    $sort.addEventListener('change', () => store.set({ sort: $sort.value as SpSort }));
    $fam.addEventListener('change', () => store.set({ fam: $fam.value || null }));
    $dep.addEventListener('change', () => store.set({ dep: $dep.value ? [$dep.value] : [] }));
    $endemic.addEventListener('change', () => store.set({ st: $endemic.checked ? 'endemica' : null }));
    $clear.addEventListener('click', () => store.set({ dep: [], fam: null, st: null }, { push: false }));

    root.querySelectorAll<HTMLButtonElement>('[data-kingdom]').forEach((b) =>
      b.addEventListener('click', () => store.set({ k: b.dataset.kingdom as K })));
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) =>
      b.addEventListener('click', () => { store.set({ view: b.dataset.view as SpView }, { push: false }); renderWindow(); }));

    $list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
      if (!b) return;
      // A build-time row clicked before the index arrived: select it by name; the detail
      // pane renders when the data lands (render() awaits it).
      if (!idx) { store.set({ sp: b.querySelector('.sci')?.textContent ?? null }); return; }
      // Keep focus on the listbox and move the keyboard cursor to the clicked row.
      active = matched.indexOf(Number(b.dataset.i));
      $list.focus({ preventScroll: true });
      store.set({ sp: idx.rows[Number(b.dataset.i)][0] });
    });
    document.getElementById('sp-close')!.addEventListener('click', () => {
      store.set({ sp: null });
      $list.focus({ preventScroll: true });
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root!.hasAttribute('data-open') && matchMedia('(max-width: 899px)').matches) store.set({ sp: null });
    });
    // Same-genus / family links inside the detail pane share the page's own store.
    $detail.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('a[data-sp], a[data-fam]');
      if (!a) return;
      e.preventDefault();
      if (a.dataset.sp) store.set({ sp: a.dataset.sp });
      else if (a.dataset.fam != null) store.set({ fam: a.dataset.fam, sp: null });
    });

    // Keyboard: arrows move one row (or one card, Left/Right in grid), Home/End jump.
    $list.addEventListener('keydown', (e) => {
      if (!matched.length) return;
      const c = cols();
      const step: Record<string, number> = { ArrowDown: c, ArrowUp: -c, ArrowRight: store.get().view === 'grid' ? 1 : 0, ArrowLeft: store.get().view === 'grid' ? -1 : 0 };
      if (e.key === 'Home') { active = 0; }
      else if (e.key === 'End') { active = matched.length - 1; }
      else if (e.key in step && step[e.key]) { active = Math.min(matched.length - 1, Math.max(0, (active < 0 ? 0 : active) + step[e.key])); }
      else if (e.key === 'Enter' && active >= 0) { store.set({ sp: idx!.rows[matched[active]][0] }); return; }
      else return;
      e.preventDefault();
      const rh = rowH(), row = Math.floor(active / c);
      $list.scrollTop = Math.min(Math.max($list.scrollTop, (row + 1) * rh - $list.clientHeight), row * rh);
      requestAnimationFrame(() => {
        renderWindow();
        $list.setAttribute('aria-activedescendant', `sp-opt-${matched[active]}`);
        document.getElementById(`sp-opt-${matched[active]}`)?.scrollIntoView({ block: 'nearest' });
      });
    });

    $list.addEventListener('scroll', () => requestAnimationFrame(renderWindow));
    addEventListener('resize', () => requestAnimationFrame(renderWindow));

    // The other kingdom is small (Fungi: ~35 KB compressed): fetch it when idle, so the
    // toggle does not wait on the network.
    function prefetchOther(k: K) {
      const other: K = k === 'plantae' ? 'fungi' : 'plantae';
      if (cache.has(other)) return;
      const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1500));
      idle(() => { void load(other).catch(() => cache.delete(other)); });
    }

    // Build-time rows are the default view (Plants, by name, no filter). Any other URL state
    // would show the wrong rows until the index lands: drop them, the count says it is loading.
    {
      const s0 = store.get();
      const isDefault = s0.k === 'plantae' && s0.sort === 'name' && s0.view === 'list' && !s0.fam && !s0.dep.length && !s0.st && !$q.value;
      if (!isDefault) { $viewport.innerHTML = ''; delete $viewport.dataset.ssr; }
    }

    store.subscribe(() => void render());
    // The index is fetched once the page has painted. Starting it at boot instead (v3.2 B1
    // A/B) moved Lighthouse's LCP 1.74 → 3.73 s: the 1.6 MB lands in the LCP path again (see
    // HANDOFF "Tried and failed"). The build-time rows are what makes the first row fast.
    void afterPaint().then(render);
  }
</script>

