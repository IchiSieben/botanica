---
/**
 * Species finder: one page for all 23,387 species.
 *
 * Why not 23,387 static pages: generating them would take minutes, weigh
 * hundreds of MB, and nobody browses an atlas that way. The columnar index
 * (species-*.json, built by etl/build_species_index.py) downloads once and the
 * search runs in the browser, with no backend and no per-query cost.
 *
 * v2: shares the explorer's URL state (?k=, ?sp=), so a selected species is a
 * link, and "Show on map" opens it in the explorer with the map following.
 */
import { t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<div class="sp" data-species-root>
  <header class="sp-head">
    <div class="sp-search">
      <label class="sr-only" for="sp-q">{t(locale, 'search.label')}</label>
      <input type="search" id="sp-q" placeholder={t(locale, 'search.placeholder')} autocomplete="off" spellcheck="false" />
      <span class="sp-count mono" id="sp-count" aria-live="polite">{t(locale, 'search.loading')}</span>
    </div>
    <div class="sp-kingdoms seg" role="group" aria-label={t(locale, 'k.label')}>
      <button type="button" class="btn on" data-kingdom="plantae" aria-pressed="true">{t(locale, 'k.plantae')}</button>
      <button type="button" class="btn" data-kingdom="fungi" aria-pressed="false">{t(locale, 'k.fungi')}</button>
    </div>
  </header>

  <div class="sp-body">
    <ol class="sp-list" id="sp-list" aria-label={t(locale, 'species.results')}></ol>
    <aside class="sp-detail" id="sp-detail" aria-live="polite">
      <p class="note">{t(locale, 'species.pick')}</p>
    </aside>
  </div>
</div>

<script>
  import { createStore, serialize, EMPTY } from '../lib/store';
  import { t, fmt, type Locale } from '../lib/i18n';
  import { deptName } from '../lib/depts';
  import { afterPaint } from '../lib/after-paint';

  type Row = [string, number, number, number, [number, number][], number, number];
  interface Index {
    meta: { flags: Record<'native' | 'introduced' | 'endemic', number> };
    families: string[]; orders: string[]; depts: string[]; lifeforms: string[]; rows: Row[];
  }
  type K = 'plantae' | 'fungi';

  const root = document.querySelector<HTMLElement>('[data-species-root]');
  if (root) {
    const locale = (document.documentElement.lang as Locale) || 'en';
    const n = fmt(locale);
    const store = createStore();
    const $q = document.getElementById('sp-q') as HTMLInputElement;
    const $list = document.getElementById('sp-list')!;
    const $detail = document.getElementById('sp-detail')!;
    const $count = document.getElementById('sp-count')!;
    const esc = (s: string) => s.replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c] as string);

    const cache = new Map<K, Promise<Index>>();
    const load = (k: K) => {
      if (!cache.has(k)) {
        const url = `${import.meta.env.BASE_URL}data/species-${k}.json`;
        cache.set(k, fetch(url, { priority: 'low' }).then((r) => {
          if (!r.ok) throw new Error(`${r.status} ${url}`);
          return r.json();
        }));
      }
      return cache.get(k)!;
    };

    // Cap on DOM rows: painting 21,585 freezes the page, and this is used by
    // typing, not by scrolling 21k rows.
    const CAP = 200;
    let idx: Index | null = null;
    let shown: number[] = [];

    function match(q: string): number[] {
      if (!idx) return [];
      if (!q) return idx.rows.map((_, i) => i);
      const needle = q.toLowerCase();
      const out: number[] = [];
      idx.rows.forEach((r, i) => {
        const fam = r[1] >= 0 ? idx!.families[r[1]] : '';
        if (r[0].toLowerCase().includes(needle) || fam.toLowerCase().includes(needle)) out.push(i);
      });
      return out;
    }

    function renderList() {
      if (!idx) return;
      const sel = store.get().sp;
      $list.innerHTML = shown.slice(0, CAP).map((i) => {
        const r = idx!.rows[i];
        const fam = r[1] >= 0 ? idx!.families[r[1]] : '—';
        return `<li><button type="button" data-i="${i}" aria-pressed="${r[0] === sel}">
          <span class="sci">${esc(r[0])}</span><span class="sp-fam">${esc(fam)}</span><span class="sp-occ mono">${r[3] ? n(r[3]) : '·'}</span></button></li>`;
      }).join('');
      const extra = shown.length > CAP ? ` · ${t(locale, 'species.showing')} ${CAP}` : '';
      $count.textContent = `${n(shown.length)} ${t(locale, 'species.of')} ${n(idx.rows.length)}${extra}`;
    }

    function renderDetail(name: string | null) {
      const i = name && idx ? idx.rows.findIndex((r) => r[0] === name) : -1;
      if (!idx || i < 0) {
        $detail.innerHTML = `<p class="note">${t(locale, 'species.pick')}</p>`;
        return;
      }
      const r = idx.rows[i];
      const fam = r[1] >= 0 ? idx.families[r[1]] : null;
      const ord = r[2] >= 0 ? idx.orders[r[2]] : null;
      const life = r[6] >= 0 ? idx.lifeforms[r[6]] : null;
      const F = idx.meta.flags;
      const tags = [
        r[5] & F.endemic ? `<span class="tag endem">${t(locale, 'sp.endemic')}</span>` : '',
        r[5] & F.native ? `<span class="tag">${t(locale, 'sp.native')}</span>` : '',
        r[5] & F.introduced ? `<span class="tag intro">${t(locale, 'sp.introduced')}</span>` : '',
      ].join('');
      const max = r[4][0]?.[1] ?? 1;
      const s = store.get();
      const mapHref = `../${serialize({ ...EMPTY, k: s.k, sp: r[0] })}`;
      const famHref = fam ? `../${serialize({ ...EMPTY, k: s.k, fam })}` : '';
      $detail.innerHTML = `
        <p class="label">${esc(ord ?? '—')} › ${esc(fam ?? '—')}</p>
        <h2 class="sci">${esc(r[0])}</h2>
        ${tags ? `<div class="tags">${tags}</div>` : ''}
        <dl class="dr-facts">
          ${life ? `<div><dt>${t(locale, 'sp.lifeform')}</dt><dd>${esc(life)}</dd></div>` : ''}
          <div><dt>${t(locale, 'sp.records')}</dt><dd class="mono">${r[3] ? n(r[3]) : t(locale, 'sp.noRecords')}</dd></div>
        </dl>
        ${r[4].length
          ? `<p class="label">${t(locale, 'sp.topDepts')}</p><ul class="dr-bars">${r[4].map(([d, c]) =>
              `<li><span>${esc(deptName(idx!.depts[d]))}</span><i style="transform:scaleX(${(c / max).toFixed(3)})"></i><b class="mono">${n(c)}</b></li>`).join('')}</ul>`
          : `<p class="note">${t(locale, 'sp.noDepts')}</p>`}
        <div class="dr-actions">
          <a class="btn" href="${mapHref}">${t(locale, 'sp.showMap')} →</a>
          ${famHref ? `<a class="btn" href="${famHref}">${t(locale, 'sp.filterFamily')} →</a>` : ''}
        </div>`;
    }

    let loadedK: K | null = null;
    async function render() {
      const s = store.get();
      root!.querySelectorAll<HTMLButtonElement>('[data-kingdom]').forEach((b) => {
        const on = b.dataset.kingdom === s.k;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      if (loadedK !== s.k) {
        $count.textContent = t(locale, 'search.loading');
        try {
          idx = await load(s.k);
        } catch (e) {
          $count.textContent = t(locale, 'species.error');
          console.warn(e);
          return;
        }
        if (store.get() !== s) return;
        loadedK = s.k;
        shown = match($q.value.trim());
      }
      renderList();
      renderDetail(s.sp);
    }

    let timer: number | undefined;
    $q.addEventListener('input', () => {
      // Search walks 21k rows: debounce so it doesn't run on every key.
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        shown = match($q.value.trim());
        renderList();
      }, 120);
    });

    $list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
      if (b && idx) store.set({ sp: idx.rows[Number(b.dataset.i)][0] });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-kingdom]').forEach((b) =>
      b.addEventListener('click', () => store.set({ k: b.dataset.kingdom as K })),
    );

    store.subscribe(() => void render());
    // The index (309 KB) is fetched once the page has painted.
    void afterPaint().then(render);
  }
</script>

<style>
  .sp { display: flex; flex-direction: column; gap: 12px; }
  .sp-head { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
  .sp-search { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; flex: 1; min-width: min(100%, 260px); }
  #sp-q {
    flex: 1 1 240px; min-width: 0; min-height: 44px; font: inherit; font-size: 16px; padding: 0 12px; border-radius: 10px;
    border: 1px solid rgb(var(--border)); background: rgb(var(--surface)); color: inherit;
  }
  #sp-q:focus { outline: none; border-color: rgb(var(--accent)); }
  /* Own line, fixed height: its text changes length after the fetch and, sharing
     a row, it re-wrapped the header (CLS 0.17). */
  .sp-count { order: 2; flex-basis: 100%; min-height: 1.6em; font-size: 12px; color: rgb(var(--muted)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  @media (min-width: 900px) { .sp-body { grid-template-columns: minmax(0, 1fr) 340px; } }
  /* Fixed height: the list fills after the fetch, and a growing box shifted
     the whole page (CLS 0.2–0.3 in the v1 audit). */
  .sp-list {
    list-style: none; margin: 0; padding: 0; height: min(66vh, 560px); overflow-y: auto;
    border: 1px solid rgb(var(--border)); border-radius: 12px; background: rgb(var(--surface));
  }
  .sp-list li + li { border-top: 1px solid rgb(var(--border) / 0.5); }
  .sp-list button {
    display: grid; grid-template-columns: minmax(0, 1fr) auto 56px; gap: 10px; align-items: baseline;
    width: 100%; min-height: 44px; text-align: left; font-size: 15px; padding: 10px 12px;
    background: transparent; border: 0; cursor: pointer;
  }
  .sp-list button:hover { background: rgb(var(--surface-2)); }
  .sp-list button[aria-pressed='true'] { background: rgb(var(--accent) / 0.12); box-shadow: inset 3px 0 0 rgb(var(--accent)); }
  .sp-list .sci { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sp-fam { font-size: 13px; color: rgb(var(--muted)); }
  .sp-occ { font-size: 12px; color: rgb(var(--muted)); text-align: right; }
  @media (max-width: 480px) { .sp-list button { grid-template-columns: minmax(0, 1fr) 48px; } .sp-fam { display: none; } }
  .sp-detail {
    border: 1px solid rgb(var(--border)); border-radius: 12px; padding: 16px; background: rgb(var(--surface));
    min-height: 200px; align-self: start;
  }
  .sp-detail :global(h2) { font-size: 22px; font-weight: 500; margin: 4px 0 10px; }
  .sp-detail :global(.tags) { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .sp-detail :global(.tag) { font-family: var(--font-mono); font-size: 12px; padding: 2px 8px; border-radius: 999px; border: 1px solid rgb(var(--border)); color: rgb(var(--muted)); }
  .sp-detail :global(.tag.endem) { border-color: rgb(var(--accent)); color: rgb(var(--accent-strong)); }
  .sp-detail :global(.tag.intro) { border-color: var(--warn); color: var(--warn); }
  .sp-detail :global(.dr-facts) { display: grid; gap: 4px; margin: 0 0 12px; font-size: 14px; }
  .sp-detail :global(.dr-facts div) { display: flex; justify-content: space-between; border-bottom: 1px dotted rgb(var(--border)); padding: 4px 0; }
  .sp-detail :global(.dr-facts dt) { color: rgb(var(--muted)); }
  .sp-detail :global(.dr-facts dd) { margin: 0; }
  .sp-detail :global(.dr-bars) { list-style: none; margin: 6px 0 14px; padding: 0; display: grid; gap: 6px; }
  .sp-detail :global(.dr-bars li) { display: grid; grid-template-columns: 110px 1fr auto; align-items: center; gap: 8px; font-size: 13px; }
  .sp-detail :global(.dr-bars i) { height: 8px; border-radius: 4px; background: rgb(var(--accent)); transform-origin: left; }
  .sp-detail :global(.dr-actions) { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
