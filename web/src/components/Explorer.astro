---
/**
 * The explorer: one shared state (store.ts, kept in the URL), six coordinated
 * views over the per-species facet columns (facets.ts), no chart library.
 *
 * The build renders the unfiltered Plantae state with the same view functions
 * the browser uses (views.ts), so the first paint is complete and stable; the
 * client script then takes over, reads the URL and re-renders on every change.
 *
 * v3: a section (#explorar) under the intro, not the page's hero. Every chart sits
 * in a ChartFrame (how to read it, legend with units, sources). Sources swap with the
 * kingdom: ChartFrame prints one source line (the plant one); the fungi line rides in
 * the legend slot and CSS shows one of the two from the root's data-k.
 */
import { aggregate } from '../lib/facets';
import { EMPTY } from '../lib/store';
import * as V from '../lib/views';
import { loadFacets, recordsByDept } from '../lib/data';
import { orderColorMap } from '../lib/clades';
import { departmentPaths } from '../lib/geo';
import { deptName } from '../lib/depts';
import { t, fmt, type Locale } from '../lib/i18n';
import { DECADE0, DECADES } from '../lib/facets';
import { SOURCES, sourceHref, type Source, type SourceKey } from '../lib/sources';
import ChartFrame from './ChartFrame.astro';
import '../styles/explorer.css';

interface Props {
  locale: Locale;
  /** The page's visually hidden h1. The intro passes false once it owns the h1. */
  h1?: boolean;
}
const { locale, h1 = true } = Astro.props;

const f = loadFacets('plantae');
const s = { ...EMPTY };
const agg = aggregate(f, s);
const orderColor = orderColorMap();
const records = recordsByDept();
const ctx: V.Ctx = { locale, f, agg, s, orderColor };
const paint = V.paintMap(ctx, records.plantae);
const { paths, width, height } = departmentPaths();
const n = fmt(locale);
const decades = Array.from({ length: DECADES }, (_, i) => DECADE0 + i * 10);
const config = { orderColor, records, base: import.meta.env.BASE_URL };

// Source lines per kingdom. Plants go through ChartFrame's own line; fungi are rendered
// here with the same markup (see the file comment).
const PLANT: SourceKey[] = ['wcvp', 'gbifPlantae'];
const FUNGI: SourceKey[] = ['gbifFungi', 'gbifBackbone'];
const esc = V.esc;
const fungiSource = (keys: SourceKey[]) => {
  const list: Source[] = keys.map((k) => SOURCES[k]);
  return `<p class="cf-source ex-src-fungi"><span class="cf-k">${t(locale, list.length > 1 ? 'frame.sources' : 'frame.source')}:</span> ` +
    list.map((x) => `<a href="${sourceHref(x)}" rel="noopener" target="_blank" lang="en">${esc(x.label)}</a>` +
      (x.version ? `<span class="cf-ver"> (${esc(x.version)})</span>` : '') +
      (x.doi ? `<span class="cf-doi"> doi:${esc(x.doi)}</span>` : '')).join(' · ') + '</p>';
};
const AUDIT = 'https://github.com/IchiSieben/botanica/blob/main/docs/AUDIT-v2.md';
---

<section id="explorar" tabindex="-1" class="ex" data-explorer data-k="plantae" aria-labelledby="ex-h">
  <div class="ex-head wrap">
    {h1 && <h1 class="sr-only">{t(locale, 'hero.title')}</h1>}
    <div class="ex-title">
      <h2 id="ex-h">{t(locale, 'ex.title')}</h2>
      <p class="ex-sub">{t(locale, 'ex.sub')}</p>
    </div>
    <div class="ex-controls">
      <div class="seg" role="group" aria-label={t(locale, 'k.label')}>
        <button type="button" class="btn on" data-k="plantae" aria-pressed="true">{t(locale, 'k.plantae')}</button>
        <button type="button" class="btn" data-k="fungi" aria-pressed="false">{t(locale, 'k.fungi')}</button>
      </div>
      <div class="search" id="search">
        <label class="sr-only" for="q">{t(locale, 'search.label')}</label>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" /></svg>
        <input id="q" type="search" autocomplete="off" spellcheck="false" placeholder={t(locale, 'search.placeholder')}
          role="combobox" aria-expanded="false" aria-controls="q-list" aria-autocomplete="list" />
        <kbd class="mono" aria-hidden="true">/</kbd>
        <ul id="q-list" role="listbox" hidden></ul>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="ex-status" aria-live="polite">
      <div class="chips" id="chips"><span class="chip-none">{t(locale, 'filters.none')}</span></div>
      <div class="kpis" id="kpis" set:html={V.kpis(ctx)} />
      <details class="ex-why" id="dep-why" hidden>
        <summary>{t(locale, 'ex.why')}</summary>
        <div class="ex-why-body">
          <p>{t(locale, 'ex.whyBody')}</p>
          <p><a href={AUDIT} rel="noopener" target="_blank">{t(locale, 'ex.whyLink')}</a></p>
        </div>
      </details>
      <p class="caveat fungi-only" hidden>{t(locale, 'fungi.caveat')}</p>
    </div>

    <div class="ex-grid">
      <ChartFrame locale={locale} id="cf-map" class="card ex-map" level={3} title={t(locale, 'map.title')}
        howto={t(locale, 'map.howto.species')} sources={PLANT}>
        <Fragment slot="tools">
          <div class="map-tools" role="group" aria-label={t(locale, 'map.zoomTip')}>
            <button type="button" class="btn ic" data-zoom="in" aria-label={t(locale, 'map.zoomIn')} title={t(locale, 'map.zoomIn')}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </button>
            <button type="button" class="btn ic" data-zoom="out" aria-label={t(locale, 'map.zoomOut')} title={t(locale, 'map.zoomOut')}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </button>
            <button type="button" class="btn ic" data-zoom="reset" aria-label={t(locale, 'map.zoomReset')} title={t(locale, 'map.zoomReset')}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <button type="button" class="btn ic" id="map-fs" aria-pressed="false" aria-label={t(locale, 'map.fs')} title={t(locale, 'map.fs')}
              data-on={t(locale, 'map.fsExit')} data-off={t(locale, 'map.fs')}>
              <svg class="fs-in" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <svg class="fs-out" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          </div>
        </Fragment>
        <div class="seg metric" role="group" aria-label={t(locale, 'map.metric')}>
          {(['species', 'records', 'coverage'] as const).map((m) => (
            <button type="button" class:list={['btn', { on: m === 'species' }]} data-m={m} aria-pressed={m === 'species' ? 'true' : 'false'}>
              {t(locale, `map.m.${m}`)}
            </button>
          ))}
        </div>
        <p class="note hint" id="map-hint">{t(locale, 'hint.map')}. <span class="hint-more">{t(locale, 'hint.more')}.</span></p>
        <p class="note locked" id="map-locked" hidden>{t(locale, 'map.metricLocked')}</p>
        <div class="map-vp" id="map-vp">
          <div class="map-zoom" id="map-zoom">
            <svg id="map" viewBox={`0 0 ${width} ${height}`} role="group" aria-label={t(locale, 'map.title')}>
              {paths.map((p, i) => (
                <path
                  d={p.d}
                  data-dep={p.name}
                  class={`q${paint.cls[p.name]}`}
                  tabindex={i === 0 ? 0 : -1}
                  role="button"
                  aria-pressed="false"
                  aria-label={`${deptName(p.name)}: ${n(paint.values[p.name] ?? 0)} ${t(locale, 'map.m.species')}`}
                />
              ))}
            </svg>
          </div>
          <p class="readout mono" id="readout" aria-hidden="true">&nbsp;</p>
        </div>
        <Fragment slot="legend">
          <div class="legend" id="legend" role="group" aria-label={t(locale, 'map.legend')} set:html={V.legend(ctx, paint, null)} />
          <Fragment set:html={fungiSource(FUNGI)} />
        </Fragment>
      </ChartFrame>

      <ChartFrame locale={locale} id="dep-panel" class="card dep-panel" level={3} title={t(locale, 'ex.depTitle')}
        howto={t(locale, 'ex.depHowto')} sources={PLANT}>
        <label class="sr-only" for="dep-select">{t(locale, 'map.title')}</label>
        <select id="dep-select" class="btn">
          <option value="">{t(locale, 'filters.none')}</option>
          {paths.map((p) => <option value={p.name}>{deptName(p.name)}</option>)}
        </select>
        <div id="dep-detail"></div>
        <Fragment slot="legend">
          <p class="ex-lg">{t(locale, 'ex.depLegend')} <span class="ex-lg-sw"><i class="sw a"></i>{t(locale, 'cmp.only')} A</span>
            <span class="ex-lg-sw"><i class="sw ab"></i>{t(locale, 'cmp.both')}</span> <span class="ex-lg-sw"><i class="sw b"></i>{t(locale, 'cmp.only')} B</span></p>
          <Fragment set:html={fungiSource(FUNGI)} />
        </Fragment>
      </ChartFrame>

      <ChartFrame locale={locale} id="cf-fam" class="card ex-fam" level={3} title={t(locale, 'fam.title')}
        howto={t(locale, 'ex.famHowto')} sources={[...PLANT, 'apg4']}>
        <div class="tm" id="families" set:html={V.families(ctx)} />
        <Fragment slot="legend">
          <p class="ex-lg"><span class="k-plantae">{t(locale, 'ex.famLegendPlantae')}</span><span class="k-fungi">{t(locale, 'ex.famLegendFungi')}</span></p>
          <Fragment set:html={fungiSource(FUNGI)} />
        </Fragment>
      </ChartFrame>

      <ChartFrame locale={locale} id="cf-st" class="card ex-st" level={3} title={t(locale, 'st.title')}
        howto={t(locale, 'ex.stHowto')} sources={PLANT}>
        <div class="bars" id="status" set:html={V.status(ctx)} />
        <Fragment slot="legend">
          <p class="ex-lg">{t(locale, 'ex.barsLegend')}</p>
          <Fragment set:html={fungiSource(FUNGI)} />
        </Fragment>
      </ChartFrame>

      <ChartFrame locale={locale} id="cf-life" class="card ex-life" level={3} title={t(locale, 'life.title')}
        howto={t(locale, 'ex.lifeHowto')} sources={PLANT}>
        <div class="bars" id="lifeforms" set:html={V.lifeforms(ctx)} />
        <Fragment slot="legend">
          <p class="ex-lg">{t(locale, 'ex.barsLegend')}</p>
          <Fragment set:html={fungiSource(FUNGI)} />
        </Fragment>
      </ChartFrame>

      <ChartFrame locale={locale} id="cf-years" class="card ex-years" level={3} title={t(locale, 'year.title')}
        howto={t(locale, 'ex.yearsHowto')} sources={['wcvp']}>
        <Fragment slot="tools">
          <div class="yr-tools">
            <label class="sr-only" for="y0">{t(locale, 'year.range')}</label>
            <select id="y0" class="btn"><option value="">{decades[0]}</option>{decades.slice(1).map((d) => <option value={d}>{d}</option>)}</select>
            <span aria-hidden="true">–</span>
            <label class="sr-only" for="y1">{t(locale, 'year.range')}</label>
            <select id="y1" class="btn">{decades.slice(0, -1).map((d) => <option value={d + 9}>{d + 9}</option>)}<option value="" selected>{decades[decades.length - 1] + 9}</option></select>
            <button type="button" class="btn" id="play" aria-pressed="false">▶ {t(locale, 'year.play')}</button>
          </div>
        </Fragment>
        <p class="note">{t(locale, 'year.note')}</p>
        <div id="years" set:html={V.years(ctx)} />
        <Fragment slot="legend">
          <p class="ex-lg">{t(locale, 'ex.yearsLegend')}</p>
        </Fragment>
      </ChartFrame>
    </div>
  </div>

  <aside class="drawer" id="drawer" aria-labelledby="dr-title" hidden>
    <div class="dr-grip" aria-hidden="true"></div>
    <button type="button" class="icon-btn dr-close" id="dr-close" aria-label={t(locale, 'sp.close')}>✕</button>
    <div id="dr-body"></div>
  </aside>

  <script type="application/json" id="ex-config" set:html={JSON.stringify(config)} />
</section>

<script>
  import { boot } from '../scripts/explorer';
  boot();
</script>
