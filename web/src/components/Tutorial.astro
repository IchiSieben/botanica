---
/**
 * Envoltorio del tutorial compartido (`public/tutorial/`, upstream en
 * Portfolio/shared/tutorial/).
 *
 * Recibe los pasos y los pasa al modulo. La ruta del import lleva BASE_URL
 * porque el sitio vive en /botanica/, no en la raiz del dominio.
 */
import { t, type Locale } from '../lib/i18n';

interface Step {
  target?: string;
  title: string;
  body: string;
  placement?: 'top' | 'bottom' | 'left' | 'right';
}
interface Props {
  id: string;
  steps: Step[];
  locale: Locale;
}
const { id, steps, locale } = Astro.props;
const base = import.meta.env.BASE_URL;
// The library is byte-identical to radar-precios' copy: only its strings are
// localised, here, through its `labels` option.
const labels = {
  next: t(locale, 'tut.next'), prev: t(locale, 'tut.prev'), done: t(locale, 'tut.done'),
  skip: t(locale, 'tut.skip'), of: t(locale, 'tut.of'),
};
---

<link rel="stylesheet" href={`${base}tutorial/tutorial.css`} />

<button type="button" id="tut-open" class="tut-open">
  ? {t(locale, 'tut.open')}
</button>

<script type="module" define:vars={{ id, steps, base, labels }}>
  // The tour starts after the first paint, so it never delays the page itself.
  await new Promise((r) => requestAnimationFrame(() => setTimeout(r, 0)));
  const { createTutorial } = await import(`${base}tutorial/tutorial.js`);
  const tour = createTutorial({
    id,
    steps,
    labels,
  });
  // Reapertura manual: el tutorial se descarta para siempre, pero tiene que
  // poder volver a verse sin borrar el localStorage a mano.
  document.getElementById('tut-open')?.addEventListener('click', () => tour.open());
</script>

<style is:global>
  /* Paleta del atlas para el tutorial compartido. */
  .ic7-tutorial-root {
    --tut-bg: rgb(var(--surface));
    --tut-fg: rgb(var(--fg));
    --tut-dim: rgb(var(--muted));
    --tut-line: rgb(var(--border));
    /* accent-strong: the light theme's plain accent is 3.5:1 on white. */
    --tut-accent: rgb(var(--accent-strong));
    --tut-font: var(--font-sans);
    --tut-mono: var(--font-mono);
  }
  /* The library hard-codes a dark ink on the accent (4.4:1 in light theme);
     the page background colour passes in both themes. */
  .ic7-tutorial-root .ic7-tutorial-next {
    color: rgb(var(--bg)) !important;
  }
</style>

<style>
  .tut-open {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 45;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgb(var(--border));
    background: rgb(var(--surface));
    color: rgb(var(--muted));
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.45);
  }
  .tut-open:hover {
    color: rgb(var(--fg));
    border-color: rgb(var(--accent));
  }
  :global(.drawer-open) .tut-open { display: none; }
</style>
