---
/**
 * Franja de KPIs por reino. Fuente: mart_kpis.
 * Plantae: taxonomía completa (incl. origen). Fungi: sin origen/endemismo
 * (no hay backbone de distribución curado) — se muestran solo los KPIs válidos.
 */
import { getKpis } from '../lib/data';
import { n, compact, pct } from '../lib/format';

interface Props { kingdom?: string; }
const { kingdom = 'Plantae' } = Astro.props;
const isFungi = kingdom === 'Fungi';
const k = getKpis(kingdom);

type Kpi = { v: string; l: string; x: string; accent: string };
const taxonomy: Kpi[] = k ? (isFungi ? [
  { v: n(k.species), l: 'especies aceptadas', x: 'rango Species', accent: 'var(--c-ros)' },
  { v: n(k.families), l: 'familias', x: 'Index Fungorum', accent: 'var(--c-mono)' },
  { v: n(k.genera), l: 'géneros', x: 'aceptados', accent: 'var(--c-ast)' },
  { v: '—', l: 'origen', x: 'sin dato (sin distribución curada)', accent: 'var(--txt-dim)' },
] : [
  { v: n(k.species), l: 'especies', x: 'rango Species', accent: 'var(--c-ros)' },
  { v: n(k.native), l: 'nativas', x: 'incl. endémicas', accent: 'var(--c-base)' },
  { v: n(k.introduced), l: 'introducidas', x: 'no nativas', accent: 'var(--c-mag)' },
  { v: n(k.endemic), l: 'endémicas', x: `${pct(k.endemic_rate)} de especies`, accent: 'var(--gold)' },
  { v: n(k.families), l: 'familias', x: 'APG IV', accent: 'var(--c-mono)' },
  { v: n(k.genera), l: 'géneros', x: 'aceptados', accent: 'var(--c-ast)' },
]) : [];

const source = isFungi ? 'Index Fungorum (vía GBIF)' : 'WCVP (Kew)';
const quality: Kpi[] = k ? [
  { v: compact(k.occurrences), l: 'ocurrencias GBIF', x: 'reino ' + kingdom, accent: 'var(--c-ros)' },
  { v: pct(k.assigned_pct), l: 'asignadas a departamento', x: `${n(k.assigned)} registros`, accent: 'var(--c-base)' },
  { v: pct(k.unassigned_pct), l: 'sin ubicar', x: `${n(k.unassigned)} costa/islas o coords erróneas`, accent: 'var(--gold)' },
] : [];
---

{k && (
  <>
    <div class="kpis">
      {taxonomy.map((kpi) => (
        <div class="kpi" style={`--accent:${kpi.accent}`}>
          <div class="v">{kpi.v}</div>
          <div class="l">{kpi.l}</div>
          <div class="x">{kpi.x}</div>
        </div>
      ))}
    </div>
    <div class="kpis quality">
      {quality.map((kpi) => (
        <div class="kpi" style={`--accent:${kpi.accent}`}>
          <div class="v">{kpi.v}</div>
          <div class="l">{kpi.l}</div>
          <div class="x">{kpi.x}</div>
        </div>
      ))}
    </div>
    <p class="note-quality" style="margin-top:8px">Backbone taxonómico: {source}.</p>
  </>
)}
