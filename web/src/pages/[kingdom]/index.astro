---
/**
 * Ruta por reino (no-default). Plantae vive en la raíz "/"; los demás reinos
 * poblados (Fungi -> /fungi/) se generan estáticamente desde los marts.
 */
import Base from '../../layouts/Base.astro';
import Overview from '../../components/Overview.astro';
import { availableKingdoms } from '../../lib/data';
import { KINGDOMS, DEFAULT_KINGDOM, kingdomSlug, getKingdom } from '../../lib/kingdoms';

export function getStaticPaths() {
  const avail = availableKingdoms();
  return KINGDOMS
    .filter((k) => k.available && avail.includes(k.code) && k.code !== DEFAULT_KINGDOM)
    .map((k) => ({ params: { kingdom: kingdomSlug(k.code) }, props: { kingdomCode: k.code } }));
}

const { kingdomCode } = Astro.props;
const kingdom = getKingdom(kingdomCode);
---

<Base title={`Atlas Botánico del Perú · ${kingdom.name}`} kingdomCode={kingdomCode}>
  <Overview kingdom={kingdomCode} />
</Base>
