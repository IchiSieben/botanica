---
/**
 * /filogenia/ — taxonomy tree coordinated with the explorer's state.
 * See PhyloTree.astro (data, honesty note) and scripts/tree.ts (behaviour).
 */
import Base from '../../layouts/Base.astro';
import PhyloTree from '../../components/PhyloTree.astro';
import Tutorial from '../../components/Tutorial.astro';
import { TOURS } from '../../lib/tours';
import { t } from '../../lib/i18n';

const locale = 'es';
---

<Base title={`${t(locale, 'tree.title')} — Botánica`} locale={locale} page="tree">
  <div class="wrap filo">
    <header class="filo-head">
      <div>
        <h1>{t(locale, 'tree.title')}</h1>
        <p class="lede">{t(locale, 'tree.lede')}</p>
      </div>
      <div class="seg" role="group" aria-label={t(locale, 'k.label')}>
        <button type="button" class="btn on" data-kset="plantae" aria-pressed="true">{t(locale, 'k.plantae')}</button>
        <button type="button" class="btn" data-kset="fungi" aria-pressed="false">{t(locale, 'k.fungi')}</button>
      </div>
    </header>
    <PhyloTree kingdom="Plantae" locale={locale} />
    <PhyloTree kingdom="Fungi" locale={locale} />
  </div>

  <Tutorial id="botanica-filogenia" locale={locale} steps={TOURS.tree[locale]} />
</Base>

<script>
  import { bootTree } from '../../scripts/tree';
  bootTree();
</script>

<style>
  .filo { display: flex; flex-direction: column; gap: 24px; padding-top: 32px; }
  .filo-head { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; justify-content: space-between; }
  .filo-head h1 { font-size: clamp(2rem, 1.2rem + 3vw, 3rem); letter-spacing: -0.02em; }
  .filo-head .lede { margin-top: 10px; max-width: 64ch; color: rgb(var(--muted)); }
</style>
