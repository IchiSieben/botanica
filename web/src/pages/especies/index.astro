---
/**
 * /especies/ — buscador de las 23 387 especies del atlas.
 * Una sola pagina + indice columnar en el cliente. Ver SpeciesBrowser.astro.
 */
import Base from '../../layouts/Base.astro';
import SpeciesBrowser from '../../components/SpeciesBrowser.astro';
import Tutorial from '../../components/Tutorial.astro';
import { TOURS } from '../../lib/tours';

const locale = 'es';
---

<Base title="Especies — Botánica" locale={locale} page="species">
  <section class="esp">
    <header class="esp-head">
      <h2>Especies</h2>
      <p>
        Las 21 585 especies de plantas y 1 802 de hongos con registro en Perú, con su familia,
        su orden y dónde se las ha encontrado. Buscá por nombre científico, género o familia.
      </p>
    </header>
    <SpeciesBrowser />
  </section>

  <Tutorial id="botanica-especies" locale={locale} steps={TOURS.species[locale]} />
</Base>

<style>
  .esp { display: flex; flex-direction: column; gap: 20px; }
  .esp-head h2 { margin: 0 0 6px; font-family: 'Fraunces', Georgia, serif; font-size: 26px; }
  .esp-head p { margin: 0; max-width: 62ch; font-size: 13px; color: var(--txt-dim); line-height: 1.6; }
</style>
