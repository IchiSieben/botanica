---
/**
 * Shell shared by every page: the landing's identity (tokens, type, focus,
 * light/dark), a three-link nav, and the data attribution the licences require.
 */
import '../styles/global.css';
import sgUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import jbUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { t, localePath, BCP47, type Locale } from '../lib/i18n';
import { KINGDOMS } from '../lib/kingdoms';

interface Props {
  locale: Locale;
  page: 'explore' | 'species' | 'tree' | 'changes';
  title?: string;
  description?: string;
}
const { locale, page, title, description } = Astro.props;
const pageTitle = title ?? t(locale, 'site.title');
const desc = description ?? t(locale, 'site.description');
const nav = [
  { id: 'explore', href: localePath(locale), label: t(locale, 'nav.explore') },
  { id: 'species', href: localePath(locale, 'especies/'), label: t(locale, 'nav.species') },
  { id: 'tree', href: localePath(locale, 'filogenia/'), label: t(locale, 'nav.tree') },
];
const slug = { explore: '', species: 'especies/', tree: 'filogenia/', changes: 'cambios/' }[page];
const other: Locale = locale === 'en' ? 'es' : 'en';
const abs = (l: Locale) => new URL(localePath(l, slug), Astro.site).href;
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preload" href={sgUrl} as="font" type="font/woff2" crossorigin />
    <!-- Mono sets KPIs and DOI lines above the fold on deep links: a late swap re-wraps them (CLS). -->
    <link rel="preload" href={jbUrl} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={abs(locale)} />
    <link rel="alternate" hreflang="en" href={abs('en')} />
    <link rel="alternate" hreflang="es" href={abs('es')} />
    <link rel="alternate" hreflang="x-default" href={abs('en')} />
    <slot name="head" />
    <!-- Language, before first paint: ?lang= wins, then the /es/ path; only the
         unprefixed (EN) pages fall back to the stored choice, then the browser.
         /es/ never redirects on its own, so there is no loop. Query and hash survive. -->
    <script is:inline define:vars={{ base: import.meta.env.BASE_URL, cur: locale }}>
      (() => {
        try {
          const u = new URL(location.href);
          const q = u.searchParams.get('lang');
          let want = null;
          if (q === 'en' || q === 'es') {
            want = q;
            try { localStorage.setItem('ic7.lang', q); } catch {}
          } else if (cur === 'en') {
            let stored = null;
            try { stored = localStorage.getItem('ic7.lang'); } catch {}
            want = stored === 'en' || stored === 'es' ? stored
              : /^es(-|$)/i.test(navigator.language || '') ? 'es' : null;
          }
          u.searchParams.delete('lang');
          const rest = u.search + u.hash;
          if (want && want !== cur) {
            const tail = u.pathname.slice(base.length).replace(/^es([/]|$)/, '');
            location.replace(base + (want === 'es' ? 'es/' : '') + tail + rest);
          } else if (q) {
            history.replaceState(history.state, '', u.pathname + rest);
          }
        } catch {}
      })();
    </script>
    <!-- Before first paint: the landing's theme key, so the choice carries over
         between the hub and this demo (same origin). -->
    <script is:inline>
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        if (stored === 'light' || (!stored && matchMedia('(prefers-color-scheme: light)').matches)) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t(locale, 'skip')}</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={localePath(locale)} aria-label={t(locale, 'site.brand')}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 21V11m0 0C12 6 8 3 4 3c0 4 3 8 8 8Zm0 0c0-4 3-7 8-7 0 4-3 7-8 7Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
          <span>{t(locale, 'site.brand')}</span>
        </a>
        <nav aria-label="Botánica">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.id === page ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="tools">
          <slot name="tools" />
          <div class="tg" role="group" aria-label={t(locale, 'hdr.langGroup')}>
            <svg class="tg-ic" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3 12h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9S9.4 5.8 12 3Z" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
            <span class="tg-k">{t(locale, 'hdr.lang')}:</span>
            <span class="tg-cur" lang={locale}>{locale.toUpperCase()}<span class="sr-only"> ({t(locale, 'hdr.langCurrent')})</span></span>
            <span class="tg-sep" aria-hidden="true">|</span>
            <a class="tg-opt" id="lang-switch" href={localePath(other, slug)} hreflang={other} lang={other}
              data-lang={other} aria-label={`${other.toUpperCase()}: ${t(other, 'hdr.langSelf')}`} title={t(other, 'hdr.langSelf')}>{other.toUpperCase()}</a>
          </div>
          <button type="button" class="tg tg-btn" id="theme-toggle" aria-label={t(locale, 'hdr.themeAriaDark')}
            data-aria-dark={t(locale, 'hdr.themeAriaDark')} data-aria-light={t(locale, 'hdr.themeAriaLight')}>
            <svg class="tg-ic ic-dark" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" fill="currentColor" /></svg>
            <svg class="tg-ic ic-light" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            <span class="tg-k">{t(locale, 'hdr.theme')}:</span>
            <span class="txt-dark">{t(locale, 'hdr.dark')}</span><span class="txt-light">{t(locale, 'hdr.light')}</span>
          </button>
          <script is:inline>
            (() => { const b = document.getElementById('theme-toggle'); if (!b) return;
              const l = document.documentElement.classList.contains('light');
              b.setAttribute('aria-label', l ? b.dataset.ariaLight : b.dataset.ariaDark); })();
          </script>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <p class="lic">
          <span>{t(locale, 'footer.data')}</span>
          <a href="https://powo.science.kew.org/about-wcvp" rel="noopener">WCVP (Kew)</a> ·
          <a href="https://www.indexfungorum.org" rel="noopener">Index Fungorum</a> ·
          {KINGDOMS.map((k, i) => (
            <>{i ? ' · ' : ''}<a href={`https://doi.org/${k.gbifDoi}`} rel="noopener">GBIF {k.code} DOI {k.gbifDoi}</a></>
          ))} ·
          <a href="https://www.geoboundaries.org" rel="noopener">geoBoundaries</a> (gbOpen PER ADM1)
        </p>
        <p>{t(locale, 'footer.caveat')}</p>
        <p class="foot-links">
          <a href="https://github.com/IchiSieben" rel="noopener">{t(locale, 'footer.code')}</a> ·
          <a href="/">{t(locale, 'nav.home')}</a> ·
          <a href={localePath(locale, 'cambios/')}>{t(locale, 'changes.nav')}</a> ·
          <span class="mono">{new Intl.DateTimeFormat(BCP47[locale], { dateStyle: 'medium' }).format(new Date('2026-06-22'))} · GBIF.org</span>
        </p>
      </div>
    </footer>

    <script>
      import { applyTier } from '../lib/tier';
      applyTier();
      // Remember the explicit choice and carry the current filters across.
      const sw = document.getElementById('lang-switch') as HTMLAnchorElement | null;
      sw?.addEventListener('click', (e) => {
        try { localStorage.setItem('ic7.lang', sw.dataset.lang!); } catch {}
        e.preventDefault();
        // ?lang= too: it wins before storage, so the choice holds even with storage blocked.
        const q = new URLSearchParams(location.search);
        q.set('lang', sw.dataset.lang!);
        location.href = `${sw.href}?${q}${location.hash}`;
      });
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isLight = document.documentElement.classList.toggle('light');
        try { localStorage.setItem('theme', isLight ? 'light' : 'dark'); } catch {}
        const b = document.getElementById('theme-toggle')!;
        b.setAttribute('aria-label', (isLight ? b.dataset.ariaLight : b.dataset.ariaDark)!);
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 8px; top: -48px; z-index: 100; padding: 8px 12px; border-radius: 8px;
    background: rgb(var(--accent)); color: rgb(var(--bg)); font-weight: 600;
  }
  .skip:focus { top: 8px; }
  header.site {
    position: sticky; top: 0; z-index: 40;
    background: rgb(var(--bg) / 0.86); backdrop-filter: blur(10px);
    border-bottom: 1px solid rgb(var(--border));
  }
  .bar { display: flex; align-items: center; gap: 12px; min-height: 56px; }
  .brand {
    display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 17px;
    min-height: 44px; min-width: 44px; justify-content: center;
    color: rgb(var(--fg)); text-decoration: none; letter-spacing: -0.01em;
  }
  .brand svg { color: rgb(var(--accent)); }
  nav { display: flex; gap: 2px; margin-left: 8px; overflow-x: auto; scrollbar-width: none; }
  nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px; border-radius: 8px;
    color: rgb(var(--muted)); text-decoration: none; font-size: 15px; white-space: nowrap;
  }
  nav a:hover { color: rgb(var(--fg)); }
  nav a[aria-current='page'] { color: rgb(var(--fg)); box-shadow: inset 0 -2px 0 rgb(var(--accent)); border-radius: 0; }
  .tools { margin-left: auto; display: flex; align-items: center; gap: 6px; }
  .tg {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 10px; border-radius: 8px;
    border: 1px solid rgb(var(--border)); background: transparent; color: rgb(var(--muted));
    font: 500 13px/1 var(--font-sans, inherit); white-space: nowrap;
  }
  .tg-ic { flex: none; color: rgb(var(--accent)); }
  .tg-k { color: rgb(var(--muted)); }
  .tg-cur { color: rgb(var(--fg)); font-weight: 700; font-family: var(--font-mono, monospace); }
  .tg-sep { color: rgb(var(--border)); }
  .tg-opt {
    display: inline-grid; place-items: center; min-width: 32px; min-height: 44px; margin: 0 -6px;
    color: rgb(var(--muted)); font-family: var(--font-mono, monospace); text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tg-opt:hover, .tg-btn:hover { color: rgb(var(--fg)); }
  .tg-btn { cursor: pointer; color: rgb(var(--fg)); }
  .ic-light, .txt-light { display: none; }
  :global(:root.light) .ic-light, :global(:root.light) .txt-light { display: inline; }
  :global(:root.light) .ic-dark, :global(:root.light) .txt-dark { display: none; }
  @media (max-width: 719px) {
    .bar { flex-wrap: wrap; row-gap: 0; padding-top: 4px; }
    nav { order: 3; flex: 1 0 100%; margin-left: -10px; }
  }
  @media (max-width: 399px) {
    .tg-k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .tg { padding: 0 8px; gap: 5px; }
  }
  @media (max-width: 560px) {
    .brand span { display: none; }
    nav a { padding: 0 8px; font-size: 14px; }
  }
  footer.site {
    margin-top: 64px; border-top: 1px solid rgb(var(--border)); padding: 24px 0 40px;
    font-size: 13px; color: rgb(var(--muted)); line-height: 1.6;
  }
  footer.site p + p { margin-top: 8px; }
  footer.site a { color: rgb(var(--muted)); }
  footer.site a:hover { color: rgb(var(--fg)); }
</style>
